# 이 파일을 .env 로 복사하면 `npm run serve` 가 자동으로 읽는다
# (node --env-file-if-exists=.env). .env 는 .gitignore 에 있다.

# --- 모의 모드 -------------------------------------------------------------
# 1이면 Neon을 호출하지 않고 전체 구매 흐름을 로컬에서 재현한다.
# 아래 자격 증명이 하나도 없어도 데모가 끝까지 돈다.
NEON_MOCK_CHECKOUT=1

# --- Neon 자격 증명 (모의 모드가 아닐 때) ----------------------------------
NEON_API_KEY=
NEON_WEBHOOK_SECRET=
NEON_API_URL=https://api.neonpay.com

# sandbox | production — 웹훅의 isSandbox 값과 반드시 일치해야 한다.
# 어긋나면 이벤트를 무시하고 200으로 응답한다(재시도 폭풍 방지).
NEON_ENVIRONMENT=sandbox

# successUrl/cancelUrl/storeUrl의 기준이 되는 주소.
# 비워 두면 요청이 들어온 오리진을 그대로 쓴다 — 로컬에서는 이게 맞다.
# (localhost로 열었는데 127.0.0.1로 돌려보내면 다른 오리진이라 세션 쿠키가
#  끊기고, 결제는 됐는데 내 것이 아닌 상태가 된다.)
# 샌드박스 테스트에서는 플레이어가 실제로 접속하는 공개 터널 주소를 넣는다.
PUBLIC_URL=

# --- 청구 국가 -------------------------------------------------------------
# 청구 국가: ①명시적 마켓 선택(cd_country 쿠키) ②위치 — 아래를 켠 배포의
# 지리 헤더, 아니면 Neon GET /prices?ip= 의 IP 지오로케이션(모의 모드 아닐 때)
# ③기본값 KR. 어떤 언어 신호도 국가를 정하지 않는다 — 게임의 ko/en 토글도,
# 브라우저 Accept-Language도. 서울의 영어 브라우저 사용자는 미국 거주자가 아니다.
# 위치가 선택과 다르면(여행·VPN) 스토어에 "제안"이 뜨고, 위치를 모를 때만
# 브라우저 지역이 같은 제안으로 뜬다. 클릭하면 그때 ①번 명시적 선택이 된다.
#
# 가격: 모의 모드가 아니면 Neon 가격표(priceTierCode)가 그 나라 가격을 정하고,
# 답이 없으면 server/catalog.mjs 의 KR/US 행을 쓴다.
#
# cf-ipcountry 같은 지리 헤더는 그것을 붙이고 클라이언트 사본을 지우는
# 프록시(CDN) 뒤에서만 의미가 있다 — 아니면 누구나 위조할 수 있는 입력이다.
# 그런 배포에서만 1로 켠다. 붙이는 절차는 deploy/README.md 참고.
TRUST_GEO_HEADERS=0
# X-Forwarded-For 의 마지막 항목을 클라이언트 주소로 믿는다. Cloud Run 처럼
# 앞단이 그 항목을 붙이는 배포에서만 1 (deploy/cloud-run.sh 가 켠다).
TRUST_PROXY=0
