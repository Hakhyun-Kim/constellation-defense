# 이 파일을 .env 로 복사하면 `npm run serve` 가 자동으로 읽는다
# (node --env-file-if-exists=.env). .env 는 .gitignore 에 있다.

# --- 모의 모드 -------------------------------------------------------------
# 1이면 Neon을 호출하지 않고 전체 구매 흐름을 로컬에서 재현한다.
# 아래 자격 증명이 하나도 없어도 데모가 끝까지 돈다.
NEON_MOCK_CHECKOUT=1

# --- Neon 자격 증명 (모의 모드가 아닐 때) ----------------------------------
NEON_API_KEY=
NEON_WEBHOOK_SECRET=
NEON_API_URL=https://api.neonpay.com

# sandbox | production — 웹훅의 isSandbox 값과 반드시 일치해야 한다.
# 어긋나면 이벤트를 무시하고 200으로 응답한다(재시도 폭풍 방지).
NEON_ENVIRONMENT=sandbox

# successUrl/cancelUrl/storeUrl의 기준이 되는 주소.
# 비워 두면 요청이 들어온 오리진을 그대로 쓴다 — 로컬에서는 이게 맞다.
# (localhost로 열었는데 127.0.0.1로 돌려보내면 다른 오리진이라 세션 쿠키가
#  끊기고, 결제는 됐는데 내 것이 아닌 상태가 된다.)
# 샌드박스 테스트에서는 플레이어가 실제로 접속하는 공개 터널 주소를 넣는다.
PUBLIC_URL=
